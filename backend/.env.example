# FinPilot Lite — Backend Environment Variables
# Copy this file to .env and fill in your values.

# Supabase project URL (found in Supabase → Project Settings → API)
SUPABASE_URL=your_supabase_url_here

# Supabase anon/public key (found in Supabase → Project Settings → API)
SUPABASE_KEY=your_supabase_anon_key_here

# Port for the Express server (default: 3000)
PORT=3000
